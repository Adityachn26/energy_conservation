# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — never commit real credentials.

# ---------- PostgreSQL (used from Phase 15) ----------
POSTGRES_USER=energy_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=smart_energy
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------- Application ----------
LOG_LEVEL=INFO
# Timezone the CEEW timestamps are recorded in (assumed IST; verify in Phase 2).
APP_TIMEZONE=Asia/Kolkata

# ---------- Defaults (can be overridden in the system_settings table) ----------
# Placeholder tariff — NOT a verified Bareilly tariff. Costs are "Estimated Cost" only.
DEFAULT_TARIFF_PER_KWH=7.0
DEFAULT_PEAK_PERCENTILE=90

# ---------- Dashboard -> API (used from Phase 17) ----------
API_BASE_URL=http://localhost:8000
